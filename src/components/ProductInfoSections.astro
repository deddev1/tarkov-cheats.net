---
import type { ProductOverview, ProductPage } from '../data/products';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';

interface Props {
  product: Pick<
    ProductPage,
    'fullFeatures' | 'goodToKnow' | 'limitations' | 'systemRequirements' | 'features' | 'more'
  >;
  overview?: ProductOverview;
}

const { product, overview } = Astro.props;
const totalFeatures = product.fullFeatures.length;
const isProductPage = Boolean(overview);
---

<section class="space-y-8 py-8" aria-label="Product details">
  {
    isProductPage && overview && (
      <div class="grid gap-6 lg:grid-cols-2">
        <Card>
          <CardHeader class="flex-row items-center gap-2 space-y-0">
            <Icon name="layers" size={16}  />
            <CardTitle class="text-sm normal-case">Overview</CardTitle>
          </CardHeader>
          <CardContent class="space-y-3">
            <h2 class="text-xl font-bold normal-case">{overview.title}</h2>
            {overview.paragraphs.map((paragraph, index) => (
              <p class:list={['text-sm text-muted-foreground', index === 0 && 'text-base text-foreground']}>{paragraph}</p>
            ))}
          </CardContent>
        </Card>
        <Card>
          <CardHeader class="flex-row items-center gap-2 space-y-0">
            <Icon name="cpu" size={16}  />
            <CardTitle class="text-sm normal-case">System requirements</CardTitle>
          </CardHeader>
          <CardContent>
            <ul class="space-y-2 text-sm text-muted-foreground" role="list">
              {product.systemRequirements.map((req) => (
                <li class="flex items-start gap-2">
                  <Icon name={req.icon} size={16} class="mt-0.5" aria-hidden="true" />
                  <span>{req.text}</span>
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      </div>
    )
  }

  <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
    <Card>
      <CardContent class="grid gap-6 pt-6 md:grid-cols-2">
        <div>
          <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase">
            <Icon name="alert" size={16} />
            Good to know
          </div>
          <p class="text-sm text-muted-foreground">{product.goodToKnow}</p>
        </div>
        <div>
          <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase">
            <Icon name="shield" size={16} />
            Important limitations
          </div>
          <p class="text-sm text-muted-foreground">{product.limitations}</p>
        </div>
      </CardContent>
    </Card>

    {
      !isProductPage && (
        <div class="space-y-4">
          <Card>
            <CardHeader class="flex-row items-center justify-between space-y-0">
              <CardTitle class="text-base normal-case">Complete feature list</CardTitle>
              <Badge>{totalFeatures} total</Badge>
            </CardHeader>
            <CardContent>
              <ul class="max-h-96 space-y-2 overflow-y-auto text-sm" role="list">
                {product.fullFeatures.map((feature, i) => (
                  <li class="flex items-start justify-between gap-2 text-muted-foreground">
                    <span class="flex items-start gap-2">
                      <Icon name="check" size={16} class="mt-0.5" aria-hidden="true" />
                      {feature}
                    </span>
                    <span class="text-xs text-muted-foreground">{String(i + 1).padStart(2, '0')}</span>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
          <Card>
            <CardHeader>
              <CardTitle class="text-base normal-case">System requirements</CardTitle>
            </CardHeader>
            <CardContent>
              <ul class="space-y-2 text-sm text-muted-foreground" role="list">
                {product.systemRequirements.map((req) => (
                  <li class="flex items-start gap-2">
                    <Icon name={req.icon} size={16} class="mt-0.5" aria-hidden="true" />
                    <span>{req.text}</span>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        </div>
      )
    }
  </div>

  {
    isProductPage && (
      <Card>
        <CardHeader class="flex-row items-center justify-between space-y-0">
          <div>
            <p class="text-xs font-semibold uppercase">Included capabilities</p>
            <CardTitle class="text-lg normal-case">Complete feature list</CardTitle>
          </div>
          <Badge>{totalFeatures} total</Badge>
        </CardHeader>
        <CardContent>
          <ul class="grid gap-2 sm:grid-cols-2" role="list">
            {product.fullFeatures.map((feature, i) => (
              <li class="flex items-start justify-between gap-2 rounded-md border border-border px-3 py-2 text-sm">
                <span class="flex items-start gap-2 text-muted-foreground">
                  <Icon name="check" size={16} class="mt-0.5" aria-hidden="true" />
                  {feature}
                </span>
                <span class="text-xs text-muted-foreground">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>
    )
  }
</section>
