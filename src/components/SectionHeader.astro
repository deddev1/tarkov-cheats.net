---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
}

const { eyebrow, title, desc, titleId, centered = false, wide = false } = Astro.props;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <h1 id={titleId} class="section-header__title">{title}</h1>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
