---
interface Props {
  href: string;
  class?: string;
  ariaLabel?: string;
}

const { href, class: className, ariaLabel } = Astro.props;
---

<a href={href} class:list={['learn-more-btn', className]} aria-label={ariaLabel}>
  <span class="learn-more-btn__text">
    <slot />
  </span>
  <span class="learn-more-btn__circle" aria-hidden="true">
    <span class="learn-more-btn__arrow"></span>
  </span>
</a>
