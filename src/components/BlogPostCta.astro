---
import { CHECKOUT_LINK_REL } from '../config/checkout';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  title: string;
  html: string;
  href: string;
}

const { title, html, href } = Astro.props;
const isCheckout = href.startsWith('/go/');
---

<aside class="blog-post-cta not-prose my-8" aria-label={title}>
  <div class="blog-post-cta__icon" aria-hidden="true">
    <Icon name="package" size={20} />
  </div>
  <div class="blog-post-cta__body">
    <h3 class="blog-post-cta__title">{title}</h3>
    <div class="blog-post-cta__text" set:html={html} />
    <Button
      as="a"
      href={href}
      rel={isCheckout ? CHECKOUT_LINK_REL : undefined}
      variant="primary"
      size="sm"
      class="blog-post-cta__btn justify-start"
    >
      Buy now
      <Icon name="arrowRight" size={16} />
    </Button>
  </div>
</aside>
